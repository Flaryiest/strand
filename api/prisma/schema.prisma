generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int            @id @default(autoincrement())
  email          String         @unique
  firstName      String?
  lastName       String?
  location       String?
  plan           Plan           @default(Basic)
  credits        Int            @default(500)
  password       String?
  googleId       String?        @unique
  profilePicture String?
  authProvider   String         @default("local")
  conversations  Conversation[]
}

model Conversation {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String?
  initialLocation String?
  creditCost    Int       @default(0)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  messages      Message[]
  chatRuns      ChatRun[]

  @@index([userId])
  @@index([uuid])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String       @db.Text
  eventLog       Json?
  metadata       Json?
  tokensUsed     Int?
  toolCallsCount Int?
  processingTime Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model ChatRun {
  id                String    @id @default(uuid())
  userId            Int
  conversationId    Int
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status            String    @default("queued")
  userMessageId     Int
  assistantMessageId Int
  location          String?
  lastSeq           Int       @default(0)
  error             String?
  metadata          Json?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  events            ChatRunEvent[]

  @@index([userId])
  @@index([conversationId])
  @@index([status])
}

model ChatRunEvent {
  id        Int      @id @default(autoincrement())
  runId     String
  run       ChatRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq       Int
  type      String
  data      Json
  createdAt DateTime @default(now())

  @@unique([runId, seq])
  @@index([runId, seq])
}

enum Plan {
  Basic
  Premium
  Pro
}
